# =====================================================================
# APEXWALL // NEON STACK
# Copy to .env.local and fill in. The app degrades gracefully when the
# AI or Auth sections are missing (local-only vault, demo AI replies).
# =====================================================================

# --- Neon Postgres (required for the cloud vault) ---
# Pooled connection string for the project, e.g.
# postgresql://neondb_owner:***@ep-xxx-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://...

# --- Neon Auth / Managed Better Auth (required for sign-in + cloud sync) ---
# Branch Auth URL — from `npx neon neon-auth status` or the Neon Console.
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth
# App secret for cached session cookies. Generate: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=change-me-to-a-random-32-char-secret

# --- Neon AI Gateway (required for live AI: race engineer, setups, telemetry) ---
# Bare branch gateway host (no path), e.g. https://br-xxx-api.ai.us-east-2.aws.neon.tech
NEON_AI_GATEWAY_BASE_URL=https://...
# Gateway bearer token (nt_live_...) — from the branch's AI Gateway page in Console.
NEON_AI_GATEWAY_TOKEN=nt_live_...

# --- AI model fallback chain (optional) ---
# Comma-separated gateway catalog model IDs. Verify against:
#   GET ${NEON_AI_GATEWAY_BASE_URL}/v1/models
# AI_MODELS=gpt-5-mini,claude-haiku-4-5,gemini-3-flash
# AI_CHAT_MODELS=gpt-5-mini,claude-haiku-4-5,gemini-3-flash

# --- Local dev server port (default 3000) ---
PORT=3000
